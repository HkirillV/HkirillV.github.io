{
  "name": "khlebov-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:ssr && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:fsd",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:visual:update": "playwright test --grep @visual --update-snapshots",
    "size": "size-limit",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "images:render": "node scripts/render-images.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.34.0",
    "@fontsource-variable/onest": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@playwright/test": "^1.55.0",
    "@size-limit/preset-app": "^11.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "lint-staged": "^16.1.6",
    "postcss-custom-media": "^12.0.1",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2",
    "size-limit": "^11.2.0",
    "steiger": "^0.5.6",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "size-limit": [
    {
      "name": "JS bundle",
      "path": "dist/assets/*.js",
      "limit": "75 kB"
    },
    {
      "name": "CSS bundle",
      "path": "dist/assets/*.css",
      "limit": "8 kB"
    }
  ]
}
